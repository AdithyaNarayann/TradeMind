# Amazon Pricing System Configuration
# Copy this to .env and configure as needed

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# LLM Settings (Optional - for enhanced features)
USE_LLM=False
# OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-3.5-turbo

# Pricing Strategy
AGGRESSIVE_PRICING=False
MIN_MARGIN_THRESHOLD=5.0
WARNING_MARGIN_THRESHOLD=10.0

# Scraper Settings
SCRAPER_TARGET_PRODUCTS=25
SCRAPER_MAX_PAGES=2
SCRAPER_MIN_DELAY=4
SCRAPER_MAX_DELAY=8
MIN_REVIEWS_THRESHOLD=10

# Data Quality
MIN_PRODUCTS_FOR_ANALYSIS=5
IQR_MULTIPLIER=2.5

# Cache Settings
CACHE_ENABLED=True
CACHE_HOURS=24
CACHE_DB_PATH=data/cache.db

# Rate Limiting (protect your IP)
MAX_REQUESTS_PER_HOUR=60
MAX_REQUESTS_PER_DAY=500

# Retry Settings
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0
