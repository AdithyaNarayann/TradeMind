# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Session
SESSION_TTL_SECONDS=3600
MAX_SESSIONS_PER_CLIENT=10

# OpenRouter LLM (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=10.0
